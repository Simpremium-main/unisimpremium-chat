# ═══════════════════════════════════════════════════════════════════
# UniSimpremium — Next.js fullstack (web + API + MCP)
# Na Vercel: Project Settings → Environment Variables (não suba o .env).
# ═══════════════════════════════════════════════════════════════════

# URL pública do app (webhooks Zappfy, links de upload no driver de disco).
APP_URL=http://localhost:3000
# A API é servida pela mesma origem; só mude se outro domínio chamar a API.
CORS_ORIGIN=http://localhost:3000

# ── Banco (Supabase Postgres) ──────────────────────────────────────
# App: pooler em transaction mode (porta 6543). connection_limit=5: a API processa
# vários jobs em paralelo na mesma instância (com 1, as transações fazem fila e expiram).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Migrations (prisma migrate deploy): conexão direta / session mode (porta 5432).
DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── Supabase (Realtime + Storage) ──────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
# Chave pública: vai para o browser assinar o Realtime.
SUPABASE_ANON_KEY=
# Chave secreta: só no servidor (broadcast do Realtime, upload no Storage).
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público dos uploads (criado automaticamente na primeira escrita).
SUPABASE_STORAGE_BUCKET=unisimpremium-uploads
# Opcional: segredo das assinaturas dos tópicos realtime (padrão: JWT_SECRET).
# REALTIME_TOPIC_SECRET=

# Filas, locks e cache rodam no próprio Postgres (sem Redis).
# Opcional: conexões do pool do runtime por instância (padrão 3).
# RUNTIME_PG_POOL_MAX=3

# ── Auth ───────────────────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Cadastro só por convite (padrão). Para permitir que qualquer pessoa crie
# uma conta (e uma organização própria), descomente as duas:
# ALLOW_PUBLIC_SIGNUP=true
# NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=true

# ── Tick de 1 minuto (/api/internal/tick) ──────────────────────────
# Mesmo valor usado em supabase/cron.sql (ou no Vercel Cron).
CRON_SECRET=
# Local (next dev / next start) o tick roda em processo; true desliga.
DISABLE_LOCAL_TICK=false

# ── Web Push (VAPID) ───────────────────────────────────────────────
# Gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:atendimento@simpremium.com.br

# ── IA ─────────────────────────────────────────────────────────────
# As chaves da OpenAI (ChatGPT) e da Anthropic (Claude) são cadastradas no app,
# em Configurações → IA (cifradas no banco), e cada agente escolhe o modelo.
# Opcional: segredo da cifra dessas chaves (padrão: JWT_SECRET). Se trocar o
# segredo depois, as chaves salvas precisam ser cadastradas de novo.
# AI_KEYS_SECRET=
# Opcional: chaves de servidor, usadas só por orgs que não cadastraram a sua.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Automações ─────────────────────────────────────────────────────
# Kill switch do motor de automações (padrão false: eventos são descartados).
AUTOMATIONS_ENABLED=false

# ── Gmail (canal GMAIL) ────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_POLL_PATTERN=*/1 * * * *
GMAIL_INITIAL_LOOKBACK_HOURS=24
GMAIL_INITIAL_BACKFILL_MAX=100

# ── Front ──────────────────────────────────────────────────────────
# Base da API no browser (padrão: /api/v1, mesma origem).
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_HOPPE_TASK_URL=

# ── MCP (só para `npm run mcp:stdio`; a rota /mcp usa a própria origem) ─
# UNISIMPREMIUM_BASE_URL=
# UNISIMPREMIUM_API_KEY=

# ── Integrações opcionais (lidas pelo código) ──────────────────────
# Descomente só as que for usar: variável vazia NÃO é igual a ausente
# (o valor padrão do código deixa de ser aplicado).
# UPLOADS_DIR=
# FFMPEG_PATH=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_SA_JSON_B64=
# DRIVE_MEET_FOLDER_ID=
# SOFIA_CALENDAR_ID=
# SOFIA_MEETING_INTERNAL_ATTENDEES=
# CLIENT_OPS_AGENT_IDS=
# HOPPE_BASE_URL=
# HOPPE_API_KEY=
# MEMBERS_TRIVAPP_URL=
# MEMBERS_ADMIN_KEY=
# MEMBERS_TENANT_ID=
# KIRVANO_WEBHOOK_SECRET=
# RECOVERY_ORG_ID=
# RECOVERY_OUTREACH_CHANNEL_ID=
# RECOVERY_AGENT_IDS=
# RECOVERY_DELAY_MINUTES=
# RECOVERY_COOLDOWN_HOURS=
# RECOVERY_MAX_ATTEMPTS=
# RECOVERY_IMMEDIATE_EVENTS=
# RECOVERY_PRODUCT_ALIASES=
# RECOVERY_WATCHDOG_CRON=
# RECOVERY_TEMPLATE_LANG=
# RECOVERY_OPENER_TEMPLATE=
# RECOVERY_OPENER_TEMPLATE_NAME=
# RECOVERY_FOLLOWUP_TEMPLATE=
# RECOVERY_FOLLOWUP_TEMPLATE_NAME=
