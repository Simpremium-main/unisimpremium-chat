{
  "name": "unisimpremium",
  "version": "1.0.0",
  "private": true,
  "description": "UniSimpremium — atendimento omnichannel (Next.js fullstack: web + API + MCP)",
  "scripts": {
    "dev": "npm run build:server && (tsc -p tsconfig.server.build.json --watch --preserveWatchOutput > .server-build.log 2>&1 & next dev --turbopack)",
    "build": "prisma generate && npm run build:server && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -P tsconfig.server.json prisma/seed.ts",
    "evals": "ts-node -P tsconfig.server.json --transpile-only src/server/modules/ai-agents/evals/cli.ts",
    "evals:agent": "ts-node -P tsconfig.server.json --transpile-only src/server/modules/ai-agents/evals/cli.ts --agent",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "build:server": "tsc -p tsconfig.server.build.json"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.server.json prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@dagrejs/dagre": "3.0.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@headlessui/react": "2.2.9",
    "@hookform/resolvers": "5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@prisma/client": "6.19.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "5.95.2",
    "@vercel/functions": "^3.10.2",
    "@xyflow/react": "12.10.2",
    "axios": "1.13.6",
    "bcrypt": "6.0.0",
    "bullmq": "5.71.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "4.9.0",
    "eta": "4.6.0",
    "express": "5.2.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "12.38.0",
    "helmet": "8.1.0",
    "lucide-react": "0.500.0",
    "next": "16.2.1",
    "next-themes": "0.4.6",
    "openai": "6.35.0",
    "passport": "0.7.0",
    "passport-custom": "1.1.1",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.72.0",
    "recharts": "3.8.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "web-push": "3.6.7",
    "zod": "3.25.76",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.17",
    "@tailwindcss/postcss": "4.2.2",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.15",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "jest": "30.4.2",
    "prisma": "6.19.2",
    "tailwindcss": "4.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
